{
  "name": "mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/mobile/src",
  "projectType": "application",
  "tags": ["scope:mobile", "type:app"],
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": ["sync-deps"],
      "options": {
        "cwd": "apps/mobile",
        "command": "npx expo start --port 8081"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["sync-deps"],
      "options": {
        "cwd": "apps/mobile",
        "command": "npx expo start --web --port 3002"
      }
    },
    "run-ios": {
      "executor": "nx:run-commands",
      "dependsOn": ["sync-deps"],
      "options": {
        "cwd": "apps/mobile",
        "command": "npx expo run:ios"
      }
    },
    "run-android": {
      "executor": "nx:run-commands",
      "dependsOn": ["sync-deps"],
      "options": {
        "cwd": "apps/mobile",
        "command": "npx expo run:android"
      }
    },
    "build": {
      "executor": "@nx/expo:build",
      "dependsOn": ["sync-deps"],
      "options": {}
    },
    "export": {
      "executor": "nx:run-commands",
      "dependsOn": ["sync-deps"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "apps/mobile",
        "command": "npx expo export --platform all --output-dir dist"
      }
    },
    "prebuild": {
      "executor": "nx:run-commands",
      "dependsOn": ["sync-deps"],
      "options": {
        "cwd": "apps/mobile",
        "command": "npx expo prebuild"
      }
    },
    "install": {
      "executor": "@nx/expo:install",
      "options": {}
    },
    "sync-deps": {
      "executor": "@nx/expo:sync-deps",
      "options": {}
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --build apps/mobile/tsconfig.app.json"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/mobile"],
      "options": {
        "jestConfig": "apps/mobile/jest.config.js"
      }
    }
  }
}
